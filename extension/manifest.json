{
    "manifest_version": 2,
    "name": "YT-DL Firefox Extension",
    "version": "1.0.0",
    "description": "Download YouTube videos with yt-dlp",
    "icons": {
        "48": "icons/icon-48.png",
        "96": "icons/icon-96.png"
    },
    "permissions": [
        "*://*.youtube.com/*",
        "http://127.0.0.1/*",
        "storage"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/watch*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_end"
        }
    ]
}