# YouTube Downloader Backend Configuration
# Copy this file to .env and customize as needed

# Backend server settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=18956

# Download settings
DOWNLOADS_DIR=  # Leave empty to use system Downloads folder (%USERPROFILE%\Downloads)

# Logging settings
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# yt-dlp settings
YTDLP_FORMAT_DEFAULT=best  # Default format when not specified
